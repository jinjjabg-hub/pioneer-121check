rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 로그인(전화번호 뒤 4자리) ─────────────────────────────────────────────
    // 이 파일의 '____' 자리에는 각자의 전화번호 뒤 4자리가 들어가야 하지만, 번호는 저장소에 올리지 않는다.
    // Firebase 콘솔 > Firestore Database > 규칙 에 붙여 넣을 때만 실제 번호로 바꾼다.
    function pins() {
      return {
        '송승훈': '____',
        '이상호': '____',
        '조현우': '____',
        '김근우': '____',
        '김경태': '____',
        '김지현': '____',
        '심학봉': '____',
        '이화춘': '____',
        '이소연': '____',
        '임춘식': '____',
        '정명수': '____',
        '홍정택': '____',
        '박진성': '____',
        '박미성': '____',
        '이채홍': '____',
        '조은영': '____',
        '박선영': '____',
        '정상현': '____',
        '이도현': '____',
        '마루이': '____',
        '문성우': '____',
        '윤민수': '____',
        '이수민': '____',
        '박지형': '____',
        '박병준': '____',
        '조진성': '____',
        '이해경': '____',
        '이은성': '____',
        '오예준': '____',
        '이훈': '____',
        '김여련': '____',
        '최소은': '____',
        '이다경': '____',
        '송이': '____',
        '이서원': '____',
        '이헌영': '____',
        '김성일': '____'
      };
    }
    function signedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }
    // 지금 로그인한 사람의 이름
    function who() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.name;
    }

    // 로그인 기록: 이름과 번호가 맞아야 만들 수 있고, 본인만 읽는다
    match /sessions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','pin'])
        && request.resource.data.name is string
        && request.resource.data.pin is string
        && pins()[request.resource.data.name] == request.resource.data.pin;
    }

    // 121 일정: 누구나 읽고, 로그인한 본인 이름으로만 열기·신청·취소·삭제
    match /slots/{id} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner','date','time','mode','memo','status','booker','createdAt'])
        && request.resource.data.owner == who()
        && request.resource.data.status == 'open'
        && request.resource.data.booker == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time.matches('^[0-2][0-9]:[0-5][0-9]$')
        && request.resource.data.mode in ['대면', '온라인', '둘 다']
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 80
        && id == request.resource.data.date + '_' + request.resource.data.time + '_' + request.resource.data.owner;

      // 바꿀 수 있는 건 status·booker뿐.
      //   열림→확정: 신청자는 로그인한 본인이고 본인 시간은 신청 불가
      //   확정→열림(취소): 신청한 사람이나 시간 주인만
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','booker'])
        && (
          (resource.data.status == 'open' && request.resource.data.status == 'booked'
            && request.resource.data.booker == who()
            && request.resource.data.booker != resource.data.owner)
          ||
          (resource.data.status == 'booked' && request.resource.data.status == 'open'
            && request.resource.data.booker == null
            && (resource.data.booker == who() || resource.data.owner == who()))
        );

      // 삭제는 시간 주인만
      allow delete: if signedIn() && resource.data.owner == who();
    }
  }
}
